#!/bin/sh
# credential_process helper for the profiles in /mnt/aws-credentials/aws-config:
# prints the credentials of one AWS profile from the file that the
# sbx-aws-developer broker of this sandbox exports on the host. The AWS CLI
# and SDKs call it again when the credentials are about to expire.
set -eu

profile=${1:?usage: aws-credential-process PROFILE}
file=/mnt/aws-credentials/credentials.json

fail() {
  echo "aws-credential-process: $*" >&2
  exit 1
}

[ -r "$file" ] || fail "$file does not exist. On the host, the sbx-aws-developer broker container of this sandbox has to run and its directory has to be mounted at /mnt/aws-credentials. This cannot be fixed inside the sandbox."

if jq -e --arg p "$profile" '
    .profiles[$p] // empty
    | select(
        (.Expiration // null) as $e
        | $e != null
          and (.SessionToken // "") != ""
          and (try ($e | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601 > now) catch true)
      )
  ' "$file"; then
  exit 0
fi

reason=$(jq -r --arg p "$profile" '
  .errors[$p]
  // (if .profiles[$p] then "the exported credentials have expired"
      else "the profile is not assigned to this sandbox on the host" end)
' "$file")
fail "no credentials for profile $profile: $reason (reported by the sbx-aws-developer broker on the host; this cannot be fixed inside the sandbox)"
